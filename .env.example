# Postgres (transactions + accounts)
POSTGRES_USER=payflow
# Generate each password with: python -c "import secrets; print(secrets.token_hex(16))"
# (hex only: these values end up inside connection strings)
POSTGRES_PASSWORD=
POSTGRES_DB=payflow
POSTGRES_PORT=5432

# MongoDB (telemetry events)
MONGO_USER=payflow
MONGO_PASSWORD=
MONGO_PORT=27017

# Cloudflare R2 (lakehouse) - filled in Phase 2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=payflow-lake
R2_ENDPOINT=

# Grafana admin login (user: admin). Required by docker-compose.yml
GRAFANA_ADMIN_PASSWORD=

# Interface the published ports bind to. 127.0.0.1 = this machine only.
# Set 0.0.0.0 only if another host (for example Airbyte) must reach a service.
# BIND_ADDR=127.0.0.1

# Simulator (Phase 1)
SIM_FRAUD_RATE=0.015
SIM_INTERVAL_SECONDS=300

# Airbyte (Phase 4 - Prefect orchestration)
AIRBYTE_URL=http://localhost:8000
# Optional OAuth2 token. Without it the flow skips the sync trigger and Airbyte
# runs on its own schedule. The three connection IDs are needed only with a token.
AIRBYTE_BEARER_TOKEN=
AIRBYTE_POSTGRES_CONNECTION_ID=
AIRBYTE_MONGO_CONNECTION_ID=
AIRBYTE_FX_CONNECTION_ID=

# Kafka (Phase 6 - Streaming)
# Set by docker-compose for containers; use localhost:29092 when running locally
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# Postgres SSL (disable for local Docker dev, enable for managed cloud Postgres)
POSTGRES_SSLMODE=disable

# Hugging Face (optional — set to avoid rate-limit warnings in normalize_merchants)
HF_TOKEN=

# ML retraining (Prefect pipeline — retrain model if Gold grows by this many rows)
MIN_RETRAIN_ROWS=1000
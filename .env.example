# Postgres (transactions + accounts)
POSTGRES_USER=payflow
POSTGRES_PASSWORD=change_me_local
POSTGRES_DB=payflow
POSTGRES_PORT=5432

# MongoDB (telemetry events)
MONGO_USER=payflow
MONGO_PASSWORD=change_me_local
MONGO_PORT=27017

# Cloudflare R2 (lakehouse) - filled in Phase 2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=payflow-lake
R2_ENDPOINT=

# Simulator (Phase 1)
SIM_FRAUD_RATE=0.015
SIM_INTERVAL_SECONDS=300

# Airbyte (Phase 4 - Prefect orchestration)
AIRBYTE_URL=http://localhost:8000
AIRBYTE_USERNAME=airbyte
AIRBYTE_PASSWORD=
AIRBYTE_POSTGRES_CONNECTION_ID=
AIRBYTE_MONGO_CONNECTION_ID=
AIRBYTE_FX_CONNECTION_ID=

# Kafka (Phase 6 - Streaming)
# Set by docker-compose for containers; use localhost:29092 when running locally
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# Postgres SSL (disable for local Docker dev, enable for managed cloud Postgres)
POSTGRES_SSLMODE=disable

# Hugging Face (optional — set to avoid rate-limit warnings in normalize_merchants)
HF_TOKEN=